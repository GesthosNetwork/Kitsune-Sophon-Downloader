<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>SophonDownloader</AssemblyName>
    <Product>Kitsune Sophon Downloader</Product>
    <AssemblyTitle>An advanced tool for downloading game assets through the Sophon-based content delivery system.</AssemblyTitle>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Core\app.ico</ApplicationIcon>
    <TargetFramework>net11.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Version>3.0.4</Version>
    <CurrentYear>$([System.DateTime]::Now.Year)</CurrentYear>
    <Copyright>Copyright © $(CurrentYear) GesthosNetwork</Copyright>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>.\bin\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="protobuf-net" Version="*" />
    <PackageReference Include="protobuf-net.Core" Version="*" />
    <PackageReference Include="SharpCompress" Version="*" />
    <PackageReference Include="ZstdSharp.Port" Version="*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="*" />
    <PackageReference Include="NLog" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Core\*" />
    <AdditionalFiles Include="Models\*.proto" />
    <EmbeddedResource Include="NLog.config" />
  </ItemGroup>

  <Target Name="KeepIjwAssembliesOutOfBundle" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
        <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
            Condition="'%(Filename)%(Extension)' == 'DirectWriteForwarder.dll' or '%(Filename)%(Extension)' == 'System.Printing.dll' or ('$(IncludeNativeLibrariesForSelfExtract)' == 'true' and '%(Filename)%(Extension)' == 'ijwhost.dll')"
            ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

  <Target Name="PostPublishCleanup" AfterTargets="Publish">
    <ItemGroup>
      <FilesToDelete Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(FilesToDelete)" />
    <RemoveDir Directories="$(ProjectDir)bin\Release;$(ProjectDir)obj" />
  </Target>

</Project>
